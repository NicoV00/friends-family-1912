---
import '../styles/global.css';
import lettering from '../lib/lettering.json';
import { getCollection } from 'astro:content';
const artists = (await getCollection('artists')).sort((a,b) => a.data.order - b.data.order);
const announced = artists.filter(artist => artist.data.photo || !/^ARTISTA/i.test(artist.data.name));
const names=announced.map(artist=>artist.data.name.toUpperCase()+(artist.data.format==='live'?' (LIVE)':''));
const ribbonMessage=[...names,'19.12','23:59','EMILE'].join('  ')+'  ';
const verticalMessage=[...names,'EMILE','19.12','MONTEVIDEO'].join('|');
const orbitMessage=[...names,'EMILE'].join('|');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#99a3aa" />
    <meta name="description" content="Viernes 19 de diciembre, 23:59. Friends & Family. Emile, Montevideo." />
    <meta property="og:title" content="19.12 — Emile, Montevideo" />
    <meta property="og:description" content={names.join(' · ')} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>19.12 — Emile, Montevideo</title>
    <link rel="preload" href="/fonts/FasePressure-Black.woff2?v=4" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      if(!matchMedia('(prefers-reduced-motion: reduce)').matches){
        document.documentElement.classList.add('is-loading');
        setTimeout(()=>document.documentElement.classList.remove('is-loading'),2500);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#lineup">Ir al lineup</a>
    <header class="site-header">
      <span class="header-date">FRIENDS &amp; FAMILY</span>
      <span class="header-date">19/12 · 23:59</span>
      <div class="header-actions">
        <button class="motion-toggle" type="button" aria-label="Pausar animaciones" aria-pressed="false" hidden><span aria-hidden="true">Ⅱ</span></button>
      </div>
    </header>
    <main id="inicio">
      <h1 class="sr-only">Viernes 19 de diciembre, 23:59. Friends &amp; Family. Emile, Montevideo.</h1>
      <section class="ribbon-section" aria-label="Emile, 19 de diciembre, Montevideo">
        <div class="ribbon" data-warp="ribbon" data-message={ribbonMessage} data-foreground="#1b1b1b" data-background="#e72b1d" data-accent="#1b1b1b" data-lens-foreground="#404040">
          <div class="ribbon-fallback" aria-hidden="true">VINCENZO — ANTUAN1101 — NIOZ — EMILE</div>
          <canvas class="warp-canvas" aria-hidden="true"></canvas>
        </div>
      </section>
      <section class="lineup-section" id="lineup" aria-labelledby="lineup-title">
        <div class="lineup-art" data-warp="vertical" data-message={verticalMessage} data-foreground="#dc4e3f" data-background="#424242" data-accent="#424242">
          <div class="vertical-fallback" aria-hidden="true">VINCENZO<br />ANTUAN1101<br />NIOZ<br />EMILE</div>
          <canvas class="warp-canvas" aria-hidden="true"></canvas>
        </div>
        <div class="date-pass" aria-hidden="true"><svg viewBox="0 0 500 180"><ellipse cx="250" cy="90" rx="246" ry="86"/><path d={lettering.date.path}/></svg></div>
        <div class="corner-signal" aria-hidden="true"><svg viewBox="0 0 160 100"><path class="signal-decoration" d="M80 -8V20M80 80V108M-8 50H20M140 50H168M28 14L42 28M118 72L132 86M28 86L42 72M118 28L132 14"/><g class="signal-lid"><path d="M8 50Q80-18 152 50Q80 118 8 50Z"/><circle class="signal-pupil" cx="80" cy="50" r="17"/></g></svg></div>
        <div class="lineup-content">
          <span class="eyebrow">VIERNES 19 DICIEMBRE · 23:59</span>
          <h2 id="lineup-title">LINEUP</h2>
          {announced.length ? <div class="artist-names sr-only">{announced.map(artist => <p class="artist-name">{artist.data.name.toUpperCase()}</p>)}</div> : <p class="announcement">POR<br />ANUNCIAR.</p>}
          <div class="lineup-note"><span>FRIENDS &amp; FAMILY<br />ELECTRONIK</span><span>VIERNES 19.12 · 23:59<br />MERCEDES 1820, MONTEVIDEO</span></div>
        </div>
      </section>
      <section class="orbit-section" aria-label="Vincenzo, Antuan1101, Nioz, Emile, Montevideo">
        <div class="orbit-meta"><span>FRIENDS &amp; FAMILY / 19.12</span><span>EMILE — MONTEVIDEO</span></div>
        <div class="orbit-art" data-warp="orbit" data-message={orbitMessage} data-foreground="#e5ff38" data-background="#6879f2" data-accent="#292b35">
          <div class="orbit-fallback" aria-hidden="true">VINCENZO<br />ANTUAN1101<br />NIOZ</div>
          <canvas class="warp-canvas" aria-hidden="true"></canvas>
        </div>
      </section>
    </main>
    <script>
      import { initFestival } from '../lib/festival';
      initFestival();
    </script>
  </body>
</html>
